// SERTEC - Circuito de aprobacion de facturas de servicio (categoria B) y anticipos (categoria C)
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  RESPONSABLE_OPERATIVO
  ANALISTA_CXP
  COMPRAS
  GERENCIA
  TESORERIA
  ADMIN
}

enum Periodicidad {
  MENSUAL
  QUINCENAL
  TRIMESTRAL
  ANUAL
  POR_EVENTO
}

enum EstadoServicio {
  PENDIENTE_DE_APROBACION
  ACTIVO
  RECHAZADO
  BAJA
}

enum EstadoPrestacion {
  PENDIENTE
  CUMPLIDO
  PARCIAL
  NO_CUMPLIDO
}

enum PrecioEstado {
  PENDIENTE_CONFIRMAR
  COINCIDE
  CONFLICTO
}

enum OrigenHistorialPrecio {
  SOLICITUD_CAMBIO_PRECIO
  CORRECCION_ADMINISTRATIVA
}

enum EstadoSolicitudPrecio {
  PENDIENTE
  APROBADA
  RECHAZADA
}

enum EstadoAnticipo {
  PENDIENTE_AUTORIZACION
  AUTORIZADO
  PAGADO
}

enum VarianteAplicacionAnticipo {
  SALDO_RESTANTE
  TOTAL_CON_CREDITO
}

model Usuario {
  id           String   @id @default(cuid())
  nombre       String
  email        String   @unique
  passwordHash String
  area         String?
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roles UsuarioRol[]

  serviciosResponsable   Servicio[]        @relation("ServicioResponsable")
  serviciosAprobados     Servicio[]        @relation("ServicioAprobadoPor")
  historialPrecioCambios HistorialPrecio[] @relation("HistorialCambiadoPor")

  solicitudesPrecioCreadas   SolicitudCambioPrecio[] @relation("SolicitudPrecioSolicitadaPor")
  solicitudesPrecioResueltas SolicitudCambioPrecio[] @relation("SolicitudPrecioResueltaPor")

  prestacionesValidadas Prestacion[] @relation("PrestacionValidadaPor")

  facturasRegistradas       Factura[] @relation("FacturaRegistradaPor")
  facturasRechazadas        Factura[] @relation("FacturaRechazadaPor")
  facturasSolicitaronExcepcion Factura[] @relation("FacturaSolicitaExcepcionPor")
  facturasExcepcionResuelta Factura[] @relation("FacturaExcepcionResueltaPor")
  facturasAutorizadas       Factura[] @relation("FacturaAutorizadaPor")
  facturasPagadas           Factura[] @relation("FacturaPagadaPor")

  anticiposSolicitados Anticipo[] @relation("AnticipoSolicitadoPor")
  anticiposAutorizados Anticipo[] @relation("AnticipoAutorizadoPor")
  anticiposPagados     Anticipo[] @relation("AnticipoPagadoPor")

  auditoria Auditoria[]
}

model UsuarioRol {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  role      RoleName

  @@unique([usuarioId, role])
}

model Servicio {
  id                      String         @id @default(cuid())
  proveedor               String
  cuit                    String
  area                    String
  descripcion             String
  responsableOperativoId  String
  responsableOperativo    Usuario        @relation("ServicioResponsable", fields: [responsableOperativoId], references: [id])
  precioVigente           Decimal        @db.Decimal(14, 2)
  periodicidad            Periodicidad
  actualizacionFrecuencia String?
  actualizacionBase       String?
  vigenteDesde            DateTime
  estado                  EstadoServicio @default(PENDIENTE_DE_APROBACION)
  aprobadoPorId           String?
  aprobadoPor             Usuario?       @relation("ServicioAprobadoPor", fields: [aprobadoPorId], references: [id])
  fechaAprobacion         DateTime?
  motivoRechazo           String?
  duracionEnPeriodos      Int?
  createdAt               DateTime       @default(now())
  updatedAt                DateTime      @updatedAt

  historialPrecio      HistorialPrecio[]
  solicitudesPrecio    SolicitudCambioPrecio[]
  prestaciones         Prestacion[]
  facturas             Factura[]
}

model HistorialPrecio {
  id             String                 @id @default(cuid())
  servicioId     String
  servicio       Servicio               @relation(fields: [servicioId], references: [id])
  precioAnterior Decimal                @db.Decimal(14, 2)
  precioNuevo    Decimal                @db.Decimal(14, 2)
  motivo         String
  origen         OrigenHistorialPrecio  @default(SOLICITUD_CAMBIO_PRECIO)
  cambiadoPorId  String
  cambiadoPor    Usuario                @relation("HistorialCambiadoPor", fields: [cambiadoPorId], references: [id])
  fecha          DateTime               @default(now())
}

model SolicitudCambioPrecio {
  id              String                 @id @default(cuid())
  servicioId      String
  servicio        Servicio               @relation(fields: [servicioId], references: [id])
  precioActual    Decimal                @db.Decimal(14, 2)
  precioPropuesto Decimal                @db.Decimal(14, 2)
  observaciones   String
  solicitadoPorId String
  solicitadoPor   Usuario                @relation("SolicitudPrecioSolicitadaPor", fields: [solicitadoPorId], references: [id])
  fechaSolicitud  DateTime               @default(now())
  estado          EstadoSolicitudPrecio  @default(PENDIENTE)
  resueltoPorId   String?
  resueltoPor     Usuario?               @relation("SolicitudPrecioResueltaPor", fields: [resueltoPorId], references: [id])
  fechaResolucion DateTime?
  motivoRechazo   String?
}

model Prestacion {
  id                String           @id @default(cuid())
  servicioId        String
  servicio          Servicio         @relation(fields: [servicioId], references: [id])
  periodo           String
  estado            EstadoPrestacion @default(PENDIENTE)
  validadoPorId     String?
  validadoPor       Usuario?         @relation("PrestacionValidadaPor", fields: [validadoPorId], references: [id])
  fecha             DateTime?
  observacion       String?
  creadoManualmente Boolean          @default(false)

  /// Cargado por el responsable operativo cuando estado = PARCIAL; puede completarlo despues de certificar.
  importeEsperadoAjustado Decimal? @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  facturaPeriodos FacturaPeriodo[]

  @@unique([servicioId, periodo])
}

model Factura {
  id                String   @id @default(cuid())
  servicioId        String
  servicio          Servicio @relation(fields: [servicioId], references: [id])
  periodoAConfirmar Boolean  @default(false)
  numeroFactura     String
  fechaFactura      DateTime
  importeFacturado  Decimal  @db.Decimal(14, 2)
  fechaRegistro     DateTime @default(now())
  registradoPorId   String
  registradoPor     Usuario  @relation("FacturaRegistradaPor", fields: [registradoPorId], references: [id])

  precioEstado        PrecioEstado @default(PENDIENTE_CONFIRMAR)
  precioConfirmadoFecha DateTime?

  // Autorizacion excepcional puntual: el Analista la pide, Gerencia la concede o deniega.
  solicitaExcepcionPrecio Boolean   @default(false)
  solicitaExcepcionMotivo String?
  solicitaExcepcionPorId  String?
  solicitaExcepcionPor    Usuario?  @relation("FacturaSolicitaExcepcionPor", fields: [solicitaExcepcionPorId], references: [id])
  solicitaExcepcionFecha  DateTime?

  excepcionPrecioConcedida     Boolean   @default(false)
  excepcionPrecioResueltaMotivo String?
  excepcionPrecioResueltaPorId  String?
  excepcionPrecioResueltaPor    Usuario?  @relation("FacturaExcepcionResueltaPor", fields: [excepcionPrecioResueltaPorId], references: [id])
  excepcionPrecioResueltaFecha  DateTime?

  rechazada       Boolean   @default(false)
  rechazadaMotivo String?
  rechazadaPorId  String?
  rechazadaPor    Usuario?  @relation("FacturaRechazadaPor", fields: [rechazadaPorId], references: [id])
  rechazadaFecha  DateTime?

  autorizado      Boolean   @default(false)
  autorizadoPorId String?
  autorizadoPor   Usuario?  @relation("FacturaAutorizadaPor", fields: [autorizadoPorId], references: [id])
  autorizadoFecha DateTime?

  pagado            Boolean   @default(false)
  comprobanteNumero String?
  comprobanteFecha  DateTime?
  pagadoPorId       String?
  pagadoPor         Usuario?  @relation("FacturaPagadaPor", fields: [pagadoPorId], references: [id])

  // Aplicacion de un anticipo (categoria C) ya pagado a esta factura real.
  anticipoId              String?                     @unique
  anticipo                Anticipo?                   @relation(fields: [anticipoId], references: [id])
  varianteAplicacionAnticipo VarianteAplicacionAnticipo?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  periodos FacturaPeriodo[]

  @@unique([servicioId, numeroFactura])
}

model FacturaPeriodo {
  id           String     @id @default(cuid())
  facturaId    String
  factura      Factura    @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  prestacionId String
  prestacion   Prestacion @relation(fields: [prestacionId], references: [id])

  @@unique([facturaId, prestacionId])
}

model Anticipo {
  id                  String         @id @default(cuid())
  proveedor           String
  cuit                String
  numeroProforma      String
  monto               Decimal        @db.Decimal(14, 2)
  fechaSolicitud      DateTime       @default(now())
  solicitadoPorId     String
  solicitadoPor       Usuario        @relation("AnticipoSolicitadoPor", fields: [solicitadoPorId], references: [id])
  fechaEstimadaEntrega DateTime?

  requiereAutorizacion Boolean        @default(false)
  estado               EstadoAnticipo @default(AUTORIZADO)
  autorizadoPorId      String?
  autorizadoPor        Usuario?       @relation("AnticipoAutorizadoPor", fields: [autorizadoPorId], references: [id])
  fechaAutorizacion    DateTime?

  pagadoPorId String?
  pagadoPor   Usuario?  @relation("AnticipoPagadoPor", fields: [pagadoPorId], references: [id])
  fechaPago   DateTime?

  aplicado Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  factura Factura?
}

model Auditoria {
  id          String   @id @default(cuid())
  usuarioId   String?
  usuario     Usuario? @relation(fields: [usuarioId], references: [id])
  fecha       DateTime @default(now())
  entidadTipo String
  entidadId   String
  accion      String
  detalle     String?
}

model ConfigSistema {
  id                         Int      @id @default(1)
  slaConflictoPrecioDias     Int      @default(3)
  slaCumplimientoParcialDias Int      @default(5)
  slaPeriodoAConfirmarDias   Int      @default(2)
  slaAprobacionDias          Int      @default(3)
  presupuestoContratoActivo  Boolean  @default(false)
  fechaCorte                 DateTime @default("2026-04-01T00:00:00.000Z")
  umbralAnticipoAutorizacion Decimal  @default(500000) @db.Decimal(14, 2)
  updatedAt                  DateTime @updatedAt
}
